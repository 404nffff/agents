# 全局默认 profile（可选）
DB_PROFILE=main

# ==================================================
# 1) 连接配置（Connection）
# ==================================================

# ----------------------------------------
# MySQL profile: main
# ----------------------------------------
MYSQL_PROFILE=main
MYSQL_HOST_main=127.0.0.1
MYSQL_PORT_main=3306
MYSQL_USER_main=root
MYSQL_PASSWORD_main=your_mysql_password
MYSQL_DATABASE_main=app_db,report_db
MYSQL_SOCKET_main=
MYSQL_TIMEOUT_main=10

# ----------------------------------------
# PostgreSQL profile: main
# ----------------------------------------
PGSQL_PROFILE=main
PGSQL_HOST_main=127.0.0.1
PGSQL_PORT_main=5432
PGSQL_USER_main=postgres
PGSQL_PASSWORD_main=your_pg_password
PGSQL_DATABASE_main=app_db,report_db
PGSQL_SSLMODE_main=disable
PGSQL_TIMEOUT_main=10

# ----------------------------------------
# MongoDB profile: main
# ----------------------------------------
MONGO_PROFILE=main
# 无认证示例：
MONGO_URI_main=mongodb://127.0.0.1:27017
# 认证示例（推荐先不指定 authMechanism，让驱动自动协商；密码中的特殊字符需 URL 编码）：
# MONGO_URI_main=mongodb://mongo_user:mongo_password@127.0.0.1:27017/?authSource=admin
# 旧版 MongoDB（不支持 SCRAM-SHA-256）可显式使用：
# MONGO_URI_main=mongodb://mongo_user:mongo_password@127.0.0.1:27017/?authSource=admin&authMechanism=SCRAM-SHA-1
MONGO_DATABASE_main=app_db
MONGO_TIMEOUT_main=10

# ----------------------------------------
# Redis profile: cache
# ----------------------------------------
REDIS_PROFILE=cache
REDIS_ADDR_cache=127.0.0.1:6379
REDIS_USER_cache=
REDIS_PASSWORD_cache=
REDIS_DB_cache=0
REDIS_TIMEOUT_cache=10

# ----------------------------------------
# Memcached profile: cache
# ----------------------------------------
MEMCACHED_PROFILE=cache
# 多节点使用逗号分隔。
MEMCACHED_ADDR_cache=127.0.0.1:11211
MEMCACHED_TIMEOUT_cache=10

# ----------------------------------------
# Elasticsearch profile: main
# ----------------------------------------
ES_PROFILE=main
ES_URL_main=http://127.0.0.1:9200
ES_USERNAME_main=
ES_PASSWORD_main=
# 原始 DSL 未显式指定 index 时，默认使用该索引。
ES_INDEX_main=student_index
ES_TIMEOUT_main=10

# ==================================================
# 2) 限制规则（Rules）
# ==================================================

# MySQL SQL 规则（可选，未设置则使用内置默认）
MYSQL_SQL_ALLOWED_START=select,show,desc,describe,explain,with
MYSQL_SQL_FORBIDDEN_KEYWORDS=delete,insert,update,replace,truncate,drop,alter,create,grant,revoke,rename,merge,call
MYSQL_SQL_FORBIDDEN_PHRASES=into_outfile,into_dumpfile,load_data,lock_tables,unlock_tables

# PostgreSQL SQL 规则（可选，未设置则使用内置默认）
PGSQL_SQL_ALLOWED_START=select,show,desc,describe,explain,with
PGSQL_SQL_FORBIDDEN_KEYWORDS=delete,insert,update,replace,truncate,drop,alter,create,grant,revoke,rename,merge,call
PGSQL_SQL_FORBIDDEN_PHRASES=into_outfile,into_dumpfile,load_data,lock_tables,unlock_tables

# MongoDB 规则（可选，未设置则使用内置默认）
# 允许操作（逗号分隔，默认 find,aggregate）
MONGO_ALLOWED_OPERATIONS_main=find,aggregate
# 聚合管道禁止 stage（逗号分隔，默认 $out,$merge）
MONGO_FORBIDDEN_AGG_STAGES_main=$out,$merge

# Redis 规则（可选，未设置则使用内置默认）
# 白名单命令（逗号分隔，默认 GET,MGET,HGET,HGETALL,SMEMBERS,ZRANGE,LRANGE,SCAN）
REDIS_ALLOWED_COMMANDS_cache=GET,MGET,HGET,HGETALL,SMEMBERS,ZRANGE,LRANGE,SCAN

# Memcached 规则（可选，未设置则使用内置默认）
# 白名单命令（逗号分隔，默认 GET,MGET）；Memcached 不支持安全的通用遍历，本工具不提供扫描能力。
MEMCACHED_ALLOWED_COMMANDS_cache=GET,MGET

# Elasticsearch 规则
# 当前固定只允许只读 _search，请勿在 query body 中传入写入类接口。
