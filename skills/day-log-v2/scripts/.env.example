# day-log-v2 第三方 AI 润色配置
# 复制为 .env 后填写真实值；.env 不应提交到仓库。

# OpenAI 兼容服务基础地址或完整对话补全地址。
# 示例基础地址：https://api.example.com
# 示例完整地址：https://api.example.com/v1/chat/completions
DAY_LOG_V2_AI_URL=

# 模型名称。
DAY_LOG_V2_AI_MODEL=

# API Key。真实值只写入 .env，不写入文档、日志或命令历史。
DAY_LOG_V2_AI_KEY=

# 可选：默认 /v1/chat/completions；如服务要求单数接口可改为 /v1/chat/completion。
DAY_LOG_V2_AI_ENDPOINT=/v1/chat/completions
