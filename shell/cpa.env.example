# CPA 脚本共享配置示例。
# shell/cpa_auth.sh 与 shell/cpa_query.sh 会默认读取“当前运行目录”下的 cpa.env。
# 建议复制本文件为 cpa.env 后填写真实值；如需改路径，可设置 CPA_ENV_FILE=/path/to/your.env

# 管理端地址，例如 http://127.0.0.1:3318
# 多连接时用英文逗号按位置分隔，例如：
# CPA_BASE_URL='http://127.0.0.1:3318,http://127.0.0.1:4318'
CPA_BASE_URL='http://127.0.0.1:3318'

# 管理端 Bearer Token。
# 多连接时与 CPA_BASE_URL 一一对应，例如：
# CPA_MANAGEMENT_TOKEN='token1,token2'
CPA_MANAGEMENT_TOKEN=''

# 通用请求超时（秒）。
CPA_TIMEOUT='30'

# 管理端 usage 汇总专用端口与超时。
CPA_USAGE_PORT='18317'
CPA_USAGE_TIMEOUT='120'

# NewAPI 日志脚本常用配置。
NEWAPI_BASE_URL='http://127.0.0.1:3333/v1'
NEWAPI_KEY=''

# OAuth 授权脚本默认选项。
CPA_AUTH_TIMEOUT='30'
CPA_AUTH_IS_WEBUI='false'

# Gemini CLI 登录时可按需预填项目 ID。
CPA_PROJECT_ID=''

# 状态轮询时可临时写入，通常也可以直接通过 --state 传。
CPA_AUTH_STATE=''

# 如管理端 usage 暴露在非默认端口，可直接写完整地址。
# CPA_USAGE_BASE_URL='http://127.0.0.1:18317'

# 如需给 cpa_query.sh 固定 ChatGPT 账号头，可取消注释。
# CPA_CHATGPT_ACCOUNT_ID=''
