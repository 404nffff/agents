# Sub2API 查询脚本配置示例。
# 复制为 shell/sub2api/.env 后填写真实 x-api-key；.env 已被 .gitignore 忽略。

# Sub2API 管理端地址，例如 http://127.0.0.1:3335
SUB2API_BASE_URL='http://127.0.0.1:3335'

# 管理端 x-api-key。不要提交真实值。
SUB2API_API_KEY=''

# 查询设置。
SUB2API_ACCOUNT_ID=''
SUB2API_ACCOUNT_IDS=''
SUB2API_SCHEDULABLE=''
SUB2API_PRIORITY=''

# accounts/keys 内部 usage 并发数。过高可能触发服务端限流。
SUB2API_PARALLELISM='6'

# 输出完整响应 JSON 的本地路径。留空时按动作自动命名：
# accounts -> shell/sub2api/accounts.json
# keys -> shell/sub2api/keys.json
# 其他动作默认不落盘；如需保存可显式传 --output 或设置 SUB2API_OUTPUT_FILE
SUB2API_OUTPUT_FILE=''
