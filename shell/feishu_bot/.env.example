# 飞书机器人脚本配置示例。
# 使用方式：复制为 .env 后填写真实值；.env 已在 .gitignore 中，不要提交真实密钥。

# 应用机器人配置。app_secret 必须填写真实值后才能发送。
FEISHU_APP_ID=''
FEISHU_APP_SECRET=''

# 已验证可用的接收者。默认只启用 chat_id，避免每次查 open_id。
# 同一时间只能启用 FEISHU_CHAT_ID / FEISHU_OPEN_ID / FEISHU_USER_ID / FEISHU_EMAIL / FEISHU_MOBILE 其中一种。
FEISHU_CHAT_ID=''
# FEISHU_OPEN_ID=''
# FEISHU_USER_ID=''

# 可选：通过邮箱或手机号查用户 ID。需要应用开通 contact:user.id:readonly。
FEISHU_EMAIL=''
FEISHU_MOBILE=''

# 可选：自定义机器人 webhook 模式。
FEISHU_BOT_WEBHOOK=''
FEISHU_BOT_SECRET=''

# 默认消息与请求超时。
FEISHU_BOT_TEXT='Codex 飞书机器人测试'
FEISHU_BOT_TIMEOUT='30'

# Codex notify hook 可选配置。
# Windows 可用 PowerShell 脚本：feishu_bot_codex_notify.ps
# Codex 配置示例：
# notify = ["powershell", "-ExecutionPolicy", "Bypass", "-File", "C:\\path\\to\\shell\\feishu_bot\\feishu_bot_codex_notify.ps"]
FEISHU_CODEX_NOTIFY_TITLE='Codex 任务完成'
FEISHU_CODEX_NOTIFY_STATUS='已完成'
FEISHU_CODEX_NOTIFY_TEMPLATE='green'
FEISHU_CODEX_NOTIFY_FOOTER='由 Codex notify 自动发送'
FEISHU_CODEX_NOTIFY_MAX_CHARS='3500'
FEISHU_CODEX_NOTIFY_LOG_PATH=''

# Codex hooks 飞书通知常用配置：feishu_codex_hook.sh / feishu_codex_hook.ps1
# 默认兼容 SessionStart/SubagentStart/PreToolUse/PermissionRequest/PostToolUse/
# PreCompact/PostCompact/UserPromptSubmit/SubagentStop/Stop。
# 是否发送 hooks 飞书通知；默认关闭。
FEISHU_CODEX_HOOK_ENABLE_PUSH='false'
# 空表示全部事件；也可写 Stop,PostToolUse 这类逗号分隔白名单。
FEISHU_CODEX_HOOK_EVENTS=''
# Stop 时用本轮 UserPromptSubmit 标题更新 Codex 会话标题；默认关闭。
# 开启后只调用官方 app-server thread/name/set，不直接修改 SQLite 状态库。
FEISHU_CODEX_HOOK_UPDATE_SESSION_TITLE='false'
