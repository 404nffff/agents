# Codex hooks 事件路由配置示例。
# 使用方式：复制为 .env 后按需修改。

# 格式：事件名:插件1,插件2;事件名:插件1
# 示例列出 Codex 当前全部 hook 事件；按需删除不想通知的事件。
# 通用入口会在 UserPromptSubmit 缓存用户输入标题，Stop 飞书通知会优先复用该标题。
CODEX_HOOK_EVENTS='SessionStart:feishu;SubagentStart:feishu;PreToolUse:feishu;PermissionRequest:feishu;PostToolUse:feishu;PreCompact:feishu;PostCompact:feishu;UserPromptSubmit:session_title;SubagentStop:feishu;Stop:feishu,session_title;'

# 可选：覆盖脱敏 payload 日志和插件错误日志位置。
# CODEX_HOOK_PAYLOAD_LOG_PATH=''
# CODEX_HOOK_ERROR_LOG_PATH=''

# 可选：覆盖标题状态文件位置；默认在 shell/codex_hook/codex_hook_title_state.json。
# CODEX_HOOK_TITLE_STATE_PATH=''
