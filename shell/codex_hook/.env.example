# Codex hooks 事件路由配置示例。
# 使用方式：复制为 .env 后按需修改。

# 插件列表支持逗号、分号或空白分隔；agents_guard 负责会话生命周期中的轻量检查。
# 通用入口会在 UserPromptSubmit 缓存用户输入标题，Stop 飞书通知会优先复用该标题。
# 单事件变量兼容下划线和事件名压缩写法，例如 SESSION_START / SESSIONSTART。

# 全局插件：追加到所有支持的 hook 事件；默认留空，避免所有事件都推送同一插件。
CODEX_HOOK_EVENTS_ALL='agents_guard'

# 会话开始：适合做项目索引检查、ai-localbase 初始化、SDLC 会话登记和会话开始通知。
CODEX_HOOK_EVENTS_SESSION_START='sdlc_session_register'

# 子代理开始：适合发送子代理启动通知；也可写作 CODEX_HOOK_EVENTS_SUBAGENT_START。
CODEX_HOOK_EVENTS_SUBAGENTSTART=''

# 工具调用前：适合记录高风险命令、敏感文件读取迹象和工具调用通知。
CODEX_HOOK_EVENTS_PRE_TOOL_USE=''

# 权限请求：适合通知需要用户确认的工具或命令。
CODEX_HOOK_EVENTS_PERMISSION_REQUEST=''

# 工具调用后：适合记录知识库异常、命令结果摘要和工具完成通知。
CODEX_HOOK_EVENTS_POST_TOOL_USE=''

# 压缩前：适合写入上下文压缩检查点，并通过 ai_localbase 上传到项目知识库。
CODEX_HOOK_EVENTS_PRE_COMPACT='ai_localbase'

# 压缩后：适合读取压缩前记忆，并输出给 Codex 恢复上下文。
CODEX_HOOK_EVENTS_POST_COMPACT='ai_localbase'

# 用户提交提示词：用于缓存本轮标题和计时开始；默认不把用户提示词推送到外部。
CODEX_HOOK_EVENTS_USER_PROMPT_SUBMIT='timer'

# 子代理结束：适合发送子代理结束通知；也可写作 CODEX_HOOK_EVENTS_SUBAGENT_STOP。
CODEX_HOOK_EVENTS_SUBAGENTSTOP=''

# 回合结束：适合收尾提醒、耗时统计、会话标题更新和飞书完成通知。
# 如需使用 AI 总结标题，可把 session_title 替换为 session_title_v2，并在插件目录配置接口参数。
# 如需在 Stop 后刷新 SDLC 文档索引，可手动追加 sdlc_watch；默认不启用，避免未确认时写入本地 SQLite。
# CODEX_HOOK_EVENTS_STOP='timer,sdlc_watch,session_title_v2,feishu'
CODEX_HOOK_EVENTS_STOP='timer,session_title_v2,feishu'

# 插件私有配置放到对应插件目录的 .env，示例见：
# - plugins/feishu/.env.example
# - plugins/session_title_v2/.env.example
# - plugins/sdlc_watch/.env.example
# ai_localbase 默认调用 ~/.codex/skills/ai-localbase/ai-localbase.ps1 或 .sh。
# sdlc_session_register 默认写入当前项目 docs/ai-register.db，可用 SDLC_SESSION_REGISTER_DB_PATH 覆盖。
