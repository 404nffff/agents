# sdlc-watch 第三方 AI 配置示例。
# 使用方式：按需复制变量到 shell/codex_hook/.env 或进程环境变量。

# 可选：OpenAI API 兼容接口。配置后，导入需求目录时只把 status.md 传给 AI，
# 并用 AI 返回的一句话写入 requirements.status 字段。
# URL 可填服务根地址或完整 /v1/chat/completions 地址。
SDLC_WATCH_AI_API_URL=''
SDLC_WATCH_AI_MODEL=''
SDLC_WATCH_AI_API_KEY=''
SDLC_WATCH_AI_TEMPERATURE='0.2'
SDLC_WATCH_AI_MAX_TOKENS='120'
SDLC_WATCH_AI_TIMEOUT='20'
