# SDLC Watch Docker Compose 配置样例。
# 复制为 .env 后，docker compose 会自动读取；不要把真实 .env 提交。

# Web 访问端口。
SDLC_WATCH_PORT=4173

# 宿主机项目根目录，容器内固定挂载为 /workspace/project。
SDLC_WATCH_PROJECT_HOST_PATH=../../../../..

# 宿主机 SQLite 索引库文件位置，容器内固定挂载为 /data/sdlc_watch.sqlite3。
# Windows 示例：D:/www/agents/shell/codex_hook/plugins/sdlc_watch/sdlc_watch.sqlite3
SDLC_WATCH_DB_HOST_PATH=../sdlc_watch.sqlite3

# 项目根目录下的文档目录名。
SDLC_WATCH_DOCS_DIR=docs
