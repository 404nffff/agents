{
  "name": "sdlc-watch-app",
  "version": "0.1.0",
  "private": true,
  "description": "SDLC Watch web client for browsing indexed SDLC documents.",
  "author": "Codex",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && node server.js",
    "serve": "node server.js",
    "build": "vite build",
    "check": "node --check server.js && node --check vite.config.mjs && npm run build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gsap/react": "^2.1.2",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/x-tree-view": "^9.4.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "gsap": "^3.14.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
