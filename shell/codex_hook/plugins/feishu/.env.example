# 飞书插件配置示例。
# 使用方式：复制为 .env 后填写真实值；不要提交真实密钥。

# 是否发送飞书通知。未开启时只维护标题状态，不发网络请求。
FEISHU_CODEX_HOOK_ENABLE_PUSH='false'
FEISHU_CODEX_HOOK_TEMPLATE='blue'
FEISHU_CODEX_HOOK_MAX_CHARS='3000'
FEISHU_CODEX_HOOK_FOOTER='由 Codex hooks 自动发送'
FEISHU_CODEX_HOOK_INCLUDE_PAYLOAD='false'

# 应用机器人配置。
FEISHU_APP_ID=''
FEISHU_APP_SECRET=''
FEISHU_CHAT_ID=''
# FEISHU_OPEN_ID=''
# FEISHU_USER_ID=''
# FEISHU_EMAIL=''
# FEISHU_MOBILE=''

FEISHU_BOT_TIMEOUT='30'
