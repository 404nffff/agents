# session_title_v2 配置示例。
# 复制为 .env 后填写本地配置；不要提交真实 API Key。

# OpenAI 兼容 Chat Completions 地址；支持完整 /v1/chat/completions，也支持 base url。
SESSION_TITLE_V2_API_URL='https://api.example.com/v1/chat/completions'

# OpenAI 兼容模型名。
SESSION_TITLE_V2_MODEL='gpt-4o-mini'

# 可选：第三方 AI API Key。插件只放到 Authorization Header，不写入日志。
SESSION_TITLE_V2_API_KEY=''

# 可选：请求超时、上下文截断和标题长度。
SESSION_TITLE_V2_TIMEOUT='10'
SESSION_TITLE_V2_MAX_CONTEXT_CHARS='12000'
SESSION_TITLE_V2_MAX_TITLE_CHARS='40'
SESSION_TITLE_V2_MAX_TOKENS='32'
SESSION_TITLE_V2_TEMPERATURE='0.2'
